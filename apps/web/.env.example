# Kopyalayın: cp apps/web/.env.example apps/web/.env.local
# Tüm değerler packages/config/src/env.ts içinde Zod ile doğrulanır.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-posta (Resend)
RESEND_API_KEY=
CONTACT_INBOX=info@futuristax.com

# Spam koruması (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Veritabanı
DATABASE_URL=

# Rate limit / cache (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI — YALNIZCA sunucuda kullanılır, asla NEXT_PUBLIC_ yapılmaz
ANTHROPIC_API_KEY=

# CMS (Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Analitik
NEXT_PUBLIC_GA_ID=
